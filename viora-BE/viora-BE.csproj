<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>viora_BE</RootNamespace>
    <UserSecretsId>viora-be-local-development</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.sso-certificates/**;**/*.pfx;**/*.p12;**/*.pfx.b64;**/*.password</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.Core" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
    <!-- IdentityModel packages must share the version required by OpenIddict. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viora.Application\Viora.Application.csproj" />
    <ProjectReference Include="..\Viora.Infrastructure\Viora.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Developer/SandboxHost/bridge.mjs" LogicalName="Ankt.SandboxHost.Bridge" />
    <EmbeddedResource Include="Developer/SandboxHost/external-link.mjs" LogicalName="Ankt.SandboxHost.ExternalLink" />
    <EmbeddedResource Include="Developer/SandboxHost/host.mjs" LogicalName="Ankt.SandboxHost.Script" />
    <EmbeddedResource Include="Production/Host/host.mjs" LogicalName="Ankt.ProductionHost.Script" />
    <EmbeddedResource Include="Production/Host/host.css" LogicalName="Ankt.ProductionHost.Style" />
    <EmbeddedResource Include="Production/Host/bridge.mjs" LogicalName="Ankt.ProductionHost.Bridge" />
    <EmbeddedResource Include="Production/Host/navigation.mjs" LogicalName="Ankt.ProductionHost.Navigation" />
    <EmbeddedResource Include="Production/Host/native.mjs" LogicalName="Ankt.ProductionHost.Native" />
  </ItemGroup>

</Project>
