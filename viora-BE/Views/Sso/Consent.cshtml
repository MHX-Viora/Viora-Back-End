@model viora_BE.Sso.SsoConsentPage
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cấp quyền đăng nhập · ANKT</title>
    <style nonce="@Model.StyleNonce">
        * { box-sizing: border-box; }
        body { margin: 0; background: #f5f7fa; color: #172536; font: 16px/1.6 system-ui, sans-serif; }
        main { width: min(100% - 32px, 500px); margin: 48px auto; padding: 32px; border: 1px solid #dbe2ea; border-radius: 20px; background: white; }
        .brand { font-weight: 800; letter-spacing: .12em; color: #125fb5; margin: 0 0 32px; }
        h1 { font-size: 26px; line-height: 1.3; margin: 16px 0 8px; overflow-wrap: anywhere; }
        .logo { width: 64px; height: 64px; border-radius: 16px; object-fit: contain; }
        .muted { color: #536477; font-size: 14px; }
        ul { padding-left: 22px; } li { margin: 12px 0; } code { font-size: 13px; }
        .actions { display: flex; gap: 12px; margin-top: 28px; }
        button { flex: 1; min-height: 48px; padding: 10px 16px; border: 1px solid #adbccd; border-radius: 10px; background: white; color: #172536; font: inherit; font-weight: 600; cursor: pointer; }
        .primary { background: #125fb5; border-color: #125fb5; color: white; }
        button:focus-visible { outline: 3px solid #e08418; outline-offset: 3px; }
        @@media (max-width: 400px) { main { margin: 20px auto; padding: 22px; } .actions { flex-direction: column-reverse; } }
    </style>
</head>
<body>
<main aria-labelledby="consent-title">
    <p class="brand">ANKT</p>
    @if (Model.LogoUrl != null) { <img class="logo" src="@Model.LogoUrl" alt="" referrerpolicy="no-referrer" /> }
    <h1 id="consent-title">Đăng nhập vào @Model.MiniApp</h1>
    <p class="muted">Nhà phát triển: @Model.Developer</p>
    <p>Ứng dụng yêu cầu sử dụng các thông tin sau:</p>
    <ul>
    @foreach (var scope in Model.Scopes)
    {
        <li>
            @switch (scope)
            {
                case "openid": <text>Định danh ANKT dành riêng cho ứng dụng.</text> break;
                case "profile": <text>Tên hiển thị và ảnh đại diện.</text> break;
                case "email": <text>Địa chỉ email đã được xác minh, nếu có.</text> break;
            }
            <code>(@scope)</code>
        </li>
    }
    </ul>
    <p class="muted">Bạn có thể thu hồi quyền trong danh sách ứng dụng đã kết nối. Chỉ tiếp tục nếu bạn tin tưởng ứng dụng này.</p>
    <form method="post" action="/connect/authorize">
        @foreach (var parameter in Model.Parameters) { <input type="hidden" name="@parameter.Key" value="@parameter.Value" /> }
        <input type="hidden" name="__RequestVerificationToken" value="@Model.CsrfToken" />
        <input type="hidden" name="consent_ticket" value="@Model.ConsentTicket" />
        <div class="actions">
            <button type="submit" name="decision" value="deny">Từ chối</button>
            <button class="primary" type="submit" name="decision" value="allow">Cho phép</button>
        </div>
    </form>
</main>
</body>
</html>
