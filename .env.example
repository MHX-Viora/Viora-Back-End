# Existing required configuration remains unchanged.

# Developer registration requires email verification. Configure these on the
# backend host too (Render Environment / VPS container environment).
# GmailApi uses HTTPS and works without SMTP ports on Render Free.
DeveloperAuth__EmailProvider=Smtp
DeveloperAuth__GmailFrom=
DeveloperAuth__GmailClientId=
DeveloperAuth__GmailClientSecret=
DeveloperAuth__GmailRefreshToken=
# PortalUrl must be the public frontend URL ending in /developers, no query/hash.
DeveloperAuth__PortalUrl=https://mxh.ankt.vn/developers
# Match ANKT_BFF_SHARED_SECRET on the frontend when signed BFF ingress is enabled.
DeveloperAuth__BffSharedSecret=
DeveloperAuth__SmtpHost=
DeveloperAuth__SmtpPort=587
DeveloperAuth__SmtpFrom=
DeveloperAuth__SmtpUser=
DeveloperAuth__SmtpPassword=
# false = STARTTLS (usually 587); true = implicit TLS (usually 465).
DeveloperAuth__SmtpImplicitTls=false
# Development loopback SMTP sinks only; never use to disable production TLS.
DeveloperAuth__AllowInsecureLocalSmtp=false
# Setup and verification: docs/operations/developer-email-setup.md
# Gmail API setup: docs/operations/developer-gmail-api.md

# Agora RTC; server-side certificate is never sent to clients.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
Live__GiftPlatformFeePercent=20

# payOS payment channel credentials. Never commit real values.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Public app routes used only for payment UX. The webhook is authoritative.
PAYOS_RETURN_URL=https://ankt.vn/wallet/deposit?status=return
PAYOS_CANCEL_URL=https://ankt.vn/wallet/deposit?status=cancelled

# Register this exact webhook URL in payOS:
PAYOS_WEBHOOK_URL=https://viora-back-end-xmco.onrender.com/api/payments/payos/webhook

# Optional wallet limits in VND.
Wallet__MinDeposit=10000
Wallet__MaxDeposit=100000000
Wallet__Fee=5000
Wallet__MinimumAmount=50000
Wallet__MaximumAmount=50000000
# Generate once: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Wallet__BankAccountEncryptionKey=

# Transient Live chat limits (per backend process).
LiveChat__RecentBufferSize=200
LiveChat__ClientDisplayLimit=100
LiveChat__MaxCommentLength=500
LiveChat__RateLimitCount=5
LiveChat__RateLimitWindowSeconds=5
LiveChat__StatsFlushSeconds=5

# Automatically close abandoned Live sessions after host heartbeats stop.
LiveLifecycle__HostTimeoutSeconds=120
LiveLifecycle__PreparingTimeoutSeconds=600
LiveLifecycle__SweepIntervalSeconds=30
