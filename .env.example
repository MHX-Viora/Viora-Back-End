# Existing required configuration remains unchanged.

# payOS payment channel credentials. Never commit real values.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Public app routes used only for payment UX. The webhook is authoritative.
PAYOS_RETURN_URL=https://your-app.example/wallet/deposit/result
PAYOS_CANCEL_URL=https://your-app.example/wallet/deposit/cancelled

# Register this exact webhook URL in payOS:
PAYOS_WEBHOOK_URL=https://digital-crative-be.onrender.com/api/payments/payos/webhook

# Optional wallet limits in VND.
Wallet__MinDeposit=10000
Wallet__MaxDeposit=100000000
Wallet__Fee=5000
Wallet__MinimumAmount=50000
Wallet__MaximumAmount=50000000
# Generate once: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Wallet__BankAccountEncryptionKey=
