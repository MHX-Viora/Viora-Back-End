# Merge into the backend's protected environment file; keep existing database/JWT/CORS settings.
# Feature remains disabled until migration, certificates and routing are verified.
OpenApi__Enabled=false
OpenApi__Issuer=https://openapi.mxh.ankt.vn/
OpenApi__Audience=ankt-open-api
OpenApi__AuthorizationUi=https://app.ankt.vn/oauth/authorize
OpenApi__KnownProxies__0=127.0.0.1
OpenApi__SigningCertificatePath=/etc/ankt/open-api/signing.pfx
OpenApi__EncryptionCertificatePath=/etc/ankt/open-api/encryption.pfx
OpenApi__CertificatePassword=REPLACE_WITH_PRIVATE_CERTIFICATE_PASSWORD
# For a local Nginx upstream. Unset PORT because Program.cs overrides URLs when PORT is set.
ASPNETCORE_URLS=http://127.0.0.1:5000
ASPNETCORE_ENVIRONMENT=Production
# Host Expo build setting: use the configured issuer, never a client secret.
# EXPO_PUBLIC_OPEN_API_ISSUER=https://openapi.mxh.ankt.vn
