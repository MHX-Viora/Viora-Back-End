# Existing backend environment; do not put real values in source control.
# Required before new Developer submissions can verify contact email.
DeveloperVerification__OtpHashKey=<independent-random-key-at-least-32-UTF8-bytes>
DeveloperVerification__SmtpHost=<trusted-SMTP-server>
DeveloperVerification__SmtpPort=587
DeveloperVerification__SmtpUsername=<SMTP-account>
DeveloperVerification__SmtpPassword=<SMTP-password>
DeveloperVerification__SenderEmail=<verified-sender-address>
# TLS is required. OTP is never returned from API or written to logs.
