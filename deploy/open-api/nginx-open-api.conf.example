# Include in nginx http{} context. TLS certificate files must already exist.
# $uri intentionally excludes query strings containing codes/state/login_ticket.
log_format ankt_open_api '$remote_addr $request_method $uri $status $request_time $request_id';
limit_req_zone $binary_remote_addr zone=ankt_open_api_ip:10m rate=10r/s;
map "$request_method:$uri" $ankt_open_api_route {
    default 0;
    "GET:/health" 1;
    "GET:/.well-known/openid-configuration" 1;
    "GET:/oauth/jwks" 1;
    "GET:/oauth/authorize" 1;
    "POST:/oauth/token" 1;
    "POST:/oauth/revoke" 1;
    "GET:/oidc/userinfo" 1;
    "GET:/v1/me" 1;
    "GET:/v1/me/profile" 1;
    "POST:/v1/account-links" 1;
    "GET:/mini-app-sdk/ankt-mini-app.js" 1;
    ~^GET:/v1/apps/[0-9a-fA-F-]{36}/permissions$ 1;
    ~^DELETE:/v1/account-links/[0-9a-fA-F-]{36}$ 1;
}

server {
    listen 80;
    server_name openapi.mxh.ankt.vn;
    # Do not reflect OAuth queries into a plain-HTTP redirect or access log.
    access_log off;
    return 400;
}

server {
    listen 443 ssl;
    server_name openapi.mxh.ankt.vn;
    ssl_certificate /etc/letsencrypt/live/openapi.mxh.ankt.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/openapi.mxh.ankt.vn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/ankt-open-api.access.log ankt_open_api;
    # Nginx errors can include the full request URI. Suppress them on this virtual host;
    # monitor upstream/application path-only metrics and the safe access log instead.
    error_log /dev/null crit;
    client_max_body_size 16k;
    client_body_timeout 10s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        if ($ankt_open_api_route = 0) { return 404; }
        limit_req zone=ankt_open_api_ip burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host openapi.mxh.ankt.vn;
        # Overwrite client-supplied forwarding headers; ASP.NET trusts only this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
        proxy_hide_header X-Powered-By;
    }
}
