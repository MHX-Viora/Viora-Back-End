# Server-only configuration. Generate a fresh cryptographically random 32-byte key as Base64.
# Store keys in a secret manager or protected environment; never commit real values.
MiniApps__ActiveKeyVersion=v1
MiniApps__EncryptionKeys__v1=<BASE64_OF_32_RANDOM_BYTES>
MiniApps__MaxAppsPerDeveloper=50
# Existing Cloudinary configuration is reused; no browser-side upload credentials.
Cloudinary__CloudName=<EXISTING_CLOUD_NAME>
Cloudinary__ApiKey=<EXISTING_API_KEY>
Cloudinary__ApiSecret=<EXISTING_API_SECRET>
# Keep previous versions configured while any database ciphertext references them.
# Changing ActiveKeyVersion affects newly created/rotated client secrets only.
