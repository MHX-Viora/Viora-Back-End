# Enter these on the backend host, not in the frontend public environment.
# SMTP example. For Render Free use developer-auth.gmail-api.env.example instead.
DeveloperAuth__EmailProvider=Smtp
# Render Free blocks Gmail SMTP ports; use a host permitting outbound SMTP.
DeveloperAuth__PortalUrl=https://mxh.ankt.vn/developers
DeveloperAuth__SmtpHost=smtp.gmail.com
DeveloperAuth__SmtpPort=587
DeveloperAuth__SmtpImplicitTls=false
DeveloperAuth__AllowInsecureLocalSmtp=false
# Set both to the same complete Gmail address you control.
DeveloperAuth__SmtpFrom=
DeveloperAuth__SmtpUser=
# Google App Password (requires 2-Step Verification), not your login password.
DeveloperAuth__SmtpPassword=
# If signed BFF ingress is used, match the frontend ANKT_BFF_SHARED_SECRET.
DeveloperAuth__BffSharedSecret=
