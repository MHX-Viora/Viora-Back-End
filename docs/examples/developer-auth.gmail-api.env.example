# Backend Render Environment only. Never expose OAuth secrets in EXPO_PUBLIC_*.
DeveloperAuth__EmailProvider=GmailApi
# Replace with the actual frontend origin followed by /developers.
DeveloperAuth__PortalUrl=https://mxh.ankt.vn/developers
# Gmail account that grants gmail.send, or its configured Gmail send-as alias.
DeveloperAuth__GmailFrom=
DeveloperAuth__GmailClientId=
DeveloperAuth__GmailClientSecret=
DeveloperAuth__GmailRefreshToken=
# Only if signed BFF ingress is enabled: match frontend ANKT_BFF_SHARED_SECRET.
DeveloperAuth__BffSharedSecret=
