# Merge into the existing backend environment; never commit actual SMTP credentials/keys.
DeveloperAuth__PortalUrl=https://mxh.ankt.vn/developers
DeveloperAuth__BffSharedSecret=
DeveloperAuth__SmtpHost=
DeveloperAuth__SmtpPort=587
DeveloperAuth__SmtpFrom=
DeveloperAuth__SmtpUser=
DeveloperAuth__SmtpPassword=
DeveloperAuth__SmtpImplicitTls=false
# Honored only in Development for localhost/127.0.0.1/::1 SMTP sinks.
DeveloperAuth__AllowInsecureLocalSmtp=false
