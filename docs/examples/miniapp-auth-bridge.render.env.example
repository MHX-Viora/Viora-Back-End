# Existing backend Render service; same API handles both launch environments.
# Configure after the approved additive Bridge migrations and matching deploy.
MiniAppAuth__Enabled=true
MiniAppAuth__AllowedHostOrigin=https://mxh.ankt.vn
SandboxTest__Enabled=true

# Preserve existing database, primary JWT, DeveloperAuth/BFF, Gmail and
# MiniApps encryption-key configuration. No Mini App frontend secret is required.
# Frontend build: EXPO_PUBLIC_MINI_APP_AUTH_BRIDGE_ENABLED=true
